# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is git-ignored, so your key stays on your computer and never goes to GitHub.

# Claude writes the video scripts in plain language when this is set.
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5
# TTS_ENGINE=auto
# EDGE_VOICE=en-US-AndrewNeural
